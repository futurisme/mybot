[Unit]
Description=FadhilBot 24/7 Discord MP4 480p-720p 30-35fps Screen-Share & On-Mic Audio Engine
Documentation=https://github.com/futurisme/fadhilbot
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/fadhilbot
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=NODE_OPTIONS="--max-old-space-size=512"
EnvironmentFile=-/opt/fadhilbot/.env
ExecStart=/usr/bin/node --max-old-space-size=512 /opt/fadhilbot/index.js

# Ubuntu 24.04 Resilient Auto-Restart (Always Alive)
Restart=always
RestartSec=3s
StartLimitIntervalSec=120
StartLimitBurst=10

# Resource Governance for 1 Dedicated vCPU & 1GB RAM (OOM Prevention)
CPUWeight=100
MemoryHigh=750M
MemoryMax=850M
KillMode=process
TimeoutStopSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fadhilbot

[Install]
WantedBy=multi-user.target
